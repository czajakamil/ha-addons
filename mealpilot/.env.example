# Skopiuj do .env i uzupełnij. docker-compose -f docker-compose.dev.yml up
# automatycznie podstawi te wartości pod ${...} w docker-compose.dev.yml.

# Konto admina tworzone/aktualizowane przy starcie
MEALPILOT_ADMIN_USERNAME=admin
MEALPILOT_ADMIN_PASSWORD=admin

# AI — bez tego asystent i ekstrakcja przepisów nie działają.
# Anthropic:
MEALPILOT_AI_API_URL=https://api.anthropic.com/v1/messages
MEALPILOT_AI_API_KEY=sk-ant-...

# Albo OpenAI:
# MEALPILOT_AI_API_URL=https://api.openai.com/v1/chat/completions
# MEALPILOT_AI_API_KEY=sk-...
